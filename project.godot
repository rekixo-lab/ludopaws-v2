; Engine configuration for Ludo Paws v2.
; Godot 4.x GDScript visual starter only; gameplay is pending Codex implementation.

config_version=5

[application]

config/name="Ludo Paws v2 - Godot Prototype"
run/main_scene="res://scenes/ui/home/home_screen.tscn"
run/main_scene.mobile="res://scenes/ui/home/home_screen.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.0", "GL Compatibility")

[display]

window/size/viewport_width=900
window/size/viewport_height=1600
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
textures/vram_compression/import_etc2_astc=true

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
